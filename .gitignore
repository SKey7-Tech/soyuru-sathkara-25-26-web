# Dependencies
node_modules/

# Next.js build output (web/)
web/.next/
web/out/
.next/
out/

# Local environment files — never commit keys
.env
.env.*
!.env.example

# Debug and log files
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
yarn-error.log*

# Miscellaneous system files
.DS_Store
Thumbs.db

# Tooling caches
.turbo
.vercel
*.tsbuildinfo
coverage/

# Database dumps
database_dump.sql

# Flutter build artifacts are handled by mobile/.gitignore.
# Do NOT ignore mobile/, supabase/ or scripts/ here — all three are tracked.
